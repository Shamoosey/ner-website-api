generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ShowItem {
  id                  String @id @default(uuid())
  title               String
  date                DateTime
  location            String
  featuring           String
  ticketUrl           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}